# KidPC production -- kidspc.online
#
# Copy to .env.production on the deployment host, fill in, then run:
#   pnpm preflight .env.production
#
# Generate every secret below with:  openssl rand -base64 48
# Do not reuse one value for two settings, and do not commit this file.

# --- domain -------------------------------------------------------------------
KIDPC_DOMAIN=kidspc.online
KIDPC_APPS_DOMAIN=apps.kidspc.online
# Where Let's Encrypt sends expiry warnings. A real, monitored mailbox.
ACME_EMAIL=

# --- secrets ------------------------------------------------------------------
# Signs access tokens. Rotating it signs every household out.
JWT_SECRET=
# Mixed into consent proof digests. Rotating it makes existing consent records
# unverifiable against a fresh proof, so treat it as permanent.
CONSENT_PEPPER=
POSTGRES_PASSWORD=

# --- consent ------------------------------------------------------------------
# THERE IS NO WORKING PRODUCTION VERIFIER YET. See docs/deploy.md.
# `mock` is refused in production by the config loader, and `digilocker` throws
# until the token exchange and signature validation are implemented.
CONSENT_VERIFIER=digilocker
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# --- desktops -----------------------------------------------------------------
DESKTOP_TAG=latest
DESKTOP_IMAGE=kidpc/desktop:latest

# --- operations ---------------------------------------------------------------
LOG_LEVEL=info
