  "include": ["packages/*/src/**/*.ts", "services/*/src/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "**/dist"],
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@kidpc/shared": ["./packages/shared/src/index.ts"],
      "@kidpc/policy": ["./packages/policy/src/index.ts"],
      "@kidpc/broker": ["./packages/broker/src/index.ts"]
    }
  }
}
