# Static file server for the built client.
#
# This is not the edge -- it holds no certificate and publishes no host port.
# It exists so the machine's real edge can `reverse_proxy` to one address
# instead of bind-mounting our build into its own container, which would mean
# recreating the edge (and dropping every other site on the host) every time
# we deploy.
:80 {
	root * /srv
	encode zstd gzip

	# Vite fingerprints these filenames, so they can be cached hard and
	# forever. index.html deliberately is not: it is how a TV picks up a new
	# build without anyone clearing anything.
	@static path /assets/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# ...which only works if we say so. With no Cache-Control at all, a browser
	# applies its own heuristic freshness and may hold index.html for hours --
	# still pointing at the previous build's hashed bundles. `no-cache` means
	# "revalidate before use", not "do not store", so it stays a conditional
	# request rather than a full download.
	@html not path /assets/* /media/*
	header @html Cache-Control "no-cache"

	# The explainer video, its poster and captions. Not fingerprinted, so not
	# immutable -- a day is long enough to spare a re-download on every visit,
	# and short enough that a re-rendered video reaches people this week.
	@media path /media/*
	header @media Cache-Control "public, max-age=86400"
	# Go's table does not know .vtt, and a captions track served as text/plain
	# is silently ignored by some TV browsers.
	@vtt path *.vtt
	header @vtt Content-Type "text/vtt; charset=utf-8"

	# Public pages are written out as HTML by the build (about/index.html and
	# so on), so a search engine and a slow TV both get the content before any
	# script runs. Anything else is a client route -- sign-in, the signed-in
	# app -- and gets app.html, the empty shell, so a parent opening their
	# dashboard never sees the home page flash up first.
	try_files {path} {path}/index.html /app.html
	file_server
}
