# KidPC edge.
#
# Caddy terminates TLS (certificates are obtained and renewed automatically),
# serves the client, and is the only process with a port open to the internet.
# It replaces a separate nginx + certbot pair, which is one fewer thing to
# forget to renew.
#
# {$KIDPC_DOMAIN} and {$KIDPC_APPS_DOMAIN} come from the environment so the same
# file serves staging and production.

{
	email {$ACME_EMAIL}
	# Uncomment while testing DNS or firewall rules -- Let's Encrypt rate-limits
	# failed attempts against the production endpoint for a week.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

(security) {
	header {
		# Two years, and only meaningful once the domain is confirmed working
		# over HTTPS -- it cannot be undone quickly.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# A service for children has no reason to touch any of these.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
}

www.{$KIDPC_DOMAIN} {
	redir https://{$KIDPC_DOMAIN}{uri} permanent
}

{$KIDPC_DOMAIN} {
	import security
	encode zstd gzip
	root * /srv

	# Two policies, because the Code Playground runs a child's own inline
	# JavaScript and `script-src 'self'` forbids that -- correctly, for our
	# pages. /sandbox.html is loaded into an opaque-origin frame purely so it
	# can carry the looser policy without ours being loosened.
	#
	# X-Frame-Options is set here per path rather than in the (security) snippet,
	# and that is not tidiness. Caddy applies the first-registered header wrapper
	# LAST, so a site-wide `X-Frame-Options DENY` silently overwrites a
	# path-scoped override further down -- verified against a live response, not
	# the config. DENY blocks same-origin framing too, which would leave the
	# preview permanently blank. One value per path, no overriding.
	@app not path /sandbox.html
	header @app {
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss://{$KIDPC_DOMAIN}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Frame-Options "DENY"
	}
	header /sandbox.html {
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; connect-src 'none'; frame-ancestors 'self'; form-action 'none'; base-uri 'none'"
		X-Frame-Options "SAMEORIGIN"
	}

	# Control-plane routes are for other KidPC components and must never be
	# reachable from a browser. Denied at the edge as well as inside the API,
	# because one of those two will eventually be misconfigured.
	handle /internal/* {
		respond 404
	}

	handle /v1/* {
		reverse_proxy api:4000
	}

	# Desktop streams. Caddy upgrades WebSockets without extra configuration;
	# the long-lived connection needs no read timeout, which is the default.
	handle /stream/* {
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	# Single-page app: every unknown path is a client route, not a missing file.
	handle {
		@static path /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Self-hosted app bundles (Scratch, Blockly, the research shell).
#
# Served on their own origin so the allow-list the egress proxy enforces is a
# whole hostname rather than a path prefix -- a desktop granted "the apps host"
# cannot thereby reach the parent dashboard.
{$KIDPC_APPS_DOMAIN} {
	import security
	encode zstd gzip
	root * /srv/apps
	file_server

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; frame-ancestors 'none'"
		# Set here rather than in (security), which no longer carries it: this
		# host has no sandbox frame, so it wants the blanket refusal.
		X-Frame-Options "DENY"
		Cache-Control "public, max-age=3600"
	}
}
