# Copy to .env and fill in. Everything here has a safe development default
# except the secrets, which have none on purpose.

# --- required in production ---------------------------------------------------
# 32+ characters. Rotating this signs everyone out.
JWT_SECRET=
# 16+ characters. Mixed into consent proof digests; rotating it makes existing
# consent records unverifiable against a fresh proof, so treat it as permanent.
CONSENT_PEPPER=
POSTGRES_PASSWORD=

# --- database -----------------------------------------------------------------
# Unset in development: the API falls back to in-process PGlite (real Postgres
# compiled to WASM) so no daemon is needed. Required in production.
# DATABASE_URL=postgres://kidpc:password@localhost:5432/kidpc
PGLITE_DIR=.data/pglite

# --- desktops -----------------------------------------------------------------
# loopback = simulated sessions, no container runtime needed. Refused in production.
SESSION_DRIVER=loopback
DESKTOP_IMAGE=kidpc/desktop:dev
DESKTOP_NETWORK=kidpc_sessions
# 'published' when the API runs on the host; 'network' when it is a container.
DESKTOP_CONNECT=published
EGRESS_PROXY=127.0.0.1:3128

# --- consent ------------------------------------------------------------------
# mock = prints a code and accepts it back. Refused in production.
CONSENT_VERIFIER=mock
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# --- server -------------------------------------------------------------------
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
REAP_INTERVAL_MS=30000
RATE_LIMITS=on
