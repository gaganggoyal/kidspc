{
  "name": "kidpc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./services/*\" --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @kidpc/api dev",
    "dev:web": "pnpm --filter @kidpc/web dev",
    "dev:tv": "KIDPC_LAN=1 pnpm dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "capacity": "tsx tools/capacity.ts",
    "icons": "tsx tools/icons.ts",
    "contrast": "tsx tools/contrast.ts",
    "orders": "pnpm --filter @kidpc/api orders",
    "demo": "tsx tools/demo.ts",
    "preflight": "tsx tools/preflight.ts",
    "format": "prettier --write .",
    "layout": "tsx tools/layout.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
